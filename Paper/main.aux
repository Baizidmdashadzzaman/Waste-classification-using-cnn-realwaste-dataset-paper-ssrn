\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-class precision ($P$), recall ($R$) and $F_1$-score of DenseNet-121 with and without the channel-attention gate on the RealWaste test set. The attention mechanism raises the overall accuracy from 79.41\% to 82.35\% and the macro-$F_1$ from 0.80 to 0.83.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tbl:ablation}{{5}{7}{Per-class precision ($P$), recall ($R$) and $F_1$-score of DenseNet-121 with and without the channel-attention gate on the RealWaste test set. The attention mechanism raises the overall accuracy from 79.41\% to 82.35\% and the macro-$F_1$ from 0.80 to 0.83}{table.caption.5}{}}
